{
  "name": "kiosco-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:web\"",
    "server": "node server/index.js",
    "web": "vite --host 127.0.0.1",
    "test": "node --test tests/*.integration.test.js",
    "test:cash": "node --test tests/cash.integration.test.js",
    "test:stock": "node --test tests/stock.integration.test.js",
    "build": "vite build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "vite": "^6.3.5"
  }
}
